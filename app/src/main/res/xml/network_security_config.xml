<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Разрешаем cleartext (HTTP) для:
         - 10.0.2.2 — адрес хоста через виртуальный роутер эмулятора (Android)
         - 192.168.1.99 — LAN IP хоста (резервный, для обхода проблем эмулятора)
         - localhost — для отладки на самом устройстве -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.99</domain>
        <domain includeSubdomains="true">192.168.1.101</domain>
    </domain-config>
</network-security-config>
